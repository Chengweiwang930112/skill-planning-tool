# One ignore file for the whole repository.
#
# A pattern starting with "/" is anchored at this file's directory (the repo
# root), so it needs the full path: "/frontend/dist/". A pattern without a
# slash matches at any depth, which is what the cache directories below rely
# on.

# --- Python (backend) ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Node and Angular (frontend) ---
node_modules/
/frontend/dist/
/frontend/coverage/
/frontend/.angular/
*.tsbuildinfo
*.log

# --- Local configuration and secrets ---
# Lockfiles (uv.lock, package-lock.json) are deliberately *not* ignored:
# reproducible installs in CI and in the container images depend on them.
.env
.env.*
!.env.example

# --- Editors and operating systems ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- The assignment document itself, which is not ours to redistribute ---
Case-Study.pdf
