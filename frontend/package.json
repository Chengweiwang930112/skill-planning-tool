{
  "name": "skill-planning-frontend",
  "version": "0.1.0",
  "description": "Angular frontend for the Staff & Skill Planning Tool",
  "private": true,
  "packageManager": "npm@11.21.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "uv run --directory ../backend python -m scripts.export_openapi > src/app/api/openapi.json && openapi-typescript src/app/api/openapi.json -o src/app/api/schema.ts"
  },
  "dependencies": {
    "@angular/aria": "^22.2.7",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@siemens/element-icons": "1.7.0",
    "@siemens/element-ng": "51.6.0",
    "@siemens/element-theme": "51.6.0",
    "@siemens/element-translate-ng": "51.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
